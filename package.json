{
  "name": "hip3-oracle-watch",
  "version": "0.1.0",
  "private": true,
  "description": "Watches oracle state and mark/oracle dislocations on Hyperliquid HIP-3 equity and commodity perps",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "tsx apps/server/src/cli.ts run",
    "collect": "tsx apps/server/src/cli.ts collect",
    "status": "tsx apps/server/src/cli.ts status",
    "compact": "tsx apps/server/src/cli.ts compact",
    "detect": "tsx apps/server/src/cli.ts detect",
    "events": "tsx apps/server/src/cli.ts events",
    "states": "tsx apps/server/src/cli.ts states",
    "serve": "tsx apps/server/src/cli.ts serve",
    "mcp": "tsx apps/server/src/cli.ts mcp",
    "alert": "tsx apps/server/src/cli.ts alert",
    "schedule": "tsx apps/server/src/cli.ts schedule",
    "buckets": "tsx apps/server/src/cli.ts buckets",
    "session": "tsx apps/server/src/cli.ts session",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present"
  }
}
